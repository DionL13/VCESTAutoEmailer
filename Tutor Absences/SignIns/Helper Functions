  let subjectName = className.split(" ").slice(0,-1).join(" "); 
  
  let subject = subjectName + " Class Cover Needed"; 
  let msgHtml = ""; // initialising message to be updated inside if statement

  for (let i = 0; i < potentialCovers.length; i+=1){
    let address = potentialCovers[i][1]; // Emailing each tutor in separate emails with a shared form link
    if (teamTutor == false){ // default condition
      msgHtml = 

      "Hi " + potentialCovers[i][0] + "," + 

      "<p> We are looking for a tutor to cover " + "<b>" + subjectName + "</b>" + " for class(es)</p>" +
      
      noTutorsHtml + 
      
      " as a <b>solo</b> tutor, and found you as a potential tutor for this subject. If you are available to cover <b>any or all</b> of these classes, please respond in the Google Form using the link below, selecting all classes you are able to cover. If you aren't able to cover any, please select the None option.</p>" +

      "<p>" + formLink + "</p>" + 

      "<p> Ops will contact you to confirm the classes that you will be covering if you do <b>not</b> select the None option. Your prompt response and help is greatly appreciated.</p>" + 

      "Thanks,"; 

      let msgPlain = msgHtml.replace(/(<([^>]+)>)/ig, ""); // replaces special characters in HTML with "" (nothing) in the body of the text
      MailApp.sendEmail(address, subject, msgPlain, {htmlBody: msgHtml}); // htmlBody formats body as an html text 
    }
    else if (teamTutor == true){
      msgHtml = 

      "Hi " + potentialCovers[i][0] + "," +

      "<p> We are looking for a tutor to cover " + subjectName + " for class(es)</p>" + 
      
      noTutorsHtml +

      " as a <b>team tutor</b> (i.e. a tutor's team tutor is absent and they have requested another tutor to assist with the class). If you are available to cover <b>any or all</b> of these classes, please respond in the Google Form link below, selecting all classes you are able to cover. If you aren't able to cover any, please select the None option.</p>" +

      "<p>" + formLink + "</p>" + 

      "<p> Ops will contact you to confirm the classes that you will be covering if you do <b>not</b> select the None option. Your prompt response and your help is greatly appreciated.</p>" + 

      "Thanks,"; 

      let msgPlain = msgHtml.replace(/(<([^>]+)>)/ig, ""); // replaces special characters in HTML with "" (nothing) in the body of the text
      MailApp.sendEmail(address, subject, msgPlain, {htmlBody: msgHtml}); // htmlBody formats body as an html text 

function tutorSignInOnEdit(e){

  // Immediately terminating function call if edit is not by Ops
  let possibleManualEditsArray = [
    "ABS", "ABS !!", "ABS - Find Cover", // Ops manual edits within classes section
    "Submit absences (and find and contact covers if applicable)",
    "Ignore (resets bolded absences to unbolded, no further action)"]; // Ops responses for manual edit management
  let edited = e.range; // gets range of edited cells from form submission
  let editedA1Notation = edited.getA1Notation();
  let blockSheet = edited.getSheet();

  // Checking if the edit is a valid manual edit to act on
  if(!possibleManualEditsArray.includes(edited.getValue())){
    // Checking if this cell is currently still bolded (and thus needs to be unbolded)
    if (blockSheet.getRange(editedA1Notation).getFontWeight() === 'bold'){
      blockSheet.getRange(editedA1Notation).setFontWeight('normal'); // Resetting back to unbolded if was previously bolded
    }
    return; // Exiting function call
  }

  // Edited cells (also can be a range if is a copy and paste of absences)
  let blockSheetData = blockSheet.getDataRange().getValues();

  let firstColumn = edited.getColumn() - 1 ; // -1 to match column index of data array. getColumn() returns first column index of all cells in the range. Accounts for a paste of multiple absences in one edit
  let lastColumn = edited.getLastColumn() - 1; // Gets last column of the edited range
  let rowIdx = edited.getRow() - 1; // -1 to match row index of data array

  let classesStartCol = convertClassLetterToColumn(["A"], 0); // Column range start for onEdit call
  let classesEndCol = convertClassLetterToColumn(["F"],0);
  let opsResponseCol = colLettertoColNumber("L"); // Indexed at 0 by default
  let opsResponseCell = blockSheet.getRange("L" + (rowIdx+1));

  let tutorCodeCol = 2;
  let classCodeCol = 0;

  // For manual class absences inputted
  if(possibleManualEditsArray.includes(edited.getValue()) && (firstColumn >= classesStartCol && lastColumn <= classesEndCol)){ // Only acting if a cell is edited to one of Ops' conditional formatting text options. Starting column after (or including) the A class column, and ending column before (or including) the F class column.

    blockSheet.getRange(editedA1Notation).setFontWeight('bold'); // Sets all edited cells from the current edit to bold

    if (blockSheetData[rowIdx][opsResponseCol] === ""){ // Will end up running multiple times on closely spaced edits, however will slightly reduce runtime

      // Putting new data validation rule in the row for the manually inputted absences
      let rule = SpreadsheetApp.newDataValidation().requireValueInList(
        ["Submit absences (and find and contact covers if applicable)",
        "Ignore (resets bolded absences to unbolded, no further action)"]
        , true) // True ensures dropdown isn't hidden
        .setAllowInvalid(false) // Rejects other inputs that the ones above
        .build(); 
      opsResponseCell.setBackground('red').setDataValidation(rule);
    }
  }

  let absentClasses;
  let absFindCoverClasses; // Storing classes which have manually been changed to ABS - Find Cover separately
  let absentClassesNoFindCover; // Storing a separate array for the absent classes which don't overlap with ABS - Find Cover classe
  let allClassesArray = ["A","B","C","D","E","F"]; // Defining an array containing all possible class letters to search for matches

  // For responses in OpsResponsesCell (i.e. saying what to do with the manual edit)
  if (firstColumn === opsResponseCol){

    let numClassesRequestingTT = 0; // Initialising the number of classes requesting a team tutor (TT)

    // Getting bolded class letters (e.g. ["A","C"])
    absentClasses = [];
    absentClassesNoFindCover = [];
    absFindCoverClasses = [];

    for (let classLetter of allClassesArray){
      let classLetterColumnLetter = convertClassLetterToColumn([classLetter],0, toNumber = false); // Gets letter of sheet corresponding to the class letter
      let classLetterColumnNumber = convertClassLetterToColumn([classLetter],0);

      // Checking which cells in the classes section for the rowIdx are bolded, then adding the class letter to the absent classes array if they are
      if (blockSheet.getRange(classLetterColumnLetter + (rowIdx+1)).getFontWeight() === 'bold'){
        absentClasses.push(classLetter);
        
        if (blockSheetData[rowIdx][classLetterColumnNumber] === "ABS - Find Cover"){ 
          numClassesRequestingTT += 1;

          absFindCoverClasses.push(classLetter); // Storing class letter if ABS - Find Cover is manually inputted for that class
        }
        else {
          // Creating copy of classes which also exist in absentClasses but noy absFindCoverClasses
          absentClassesNoFindCover.push(classLetter);
        }
      }
    }

    // Actioning manual edit
    if (blockSheetData[rowIdx][opsResponseCol] === "Submit absences (and find and contact covers if applicable)"){

      opsResponseCell.clearDataValidations().setValue("Updating sheet...").setBackground('blue'); // Removing data validation of opsResponseCell

      // Getting key information required for a form submission
      let tutorCode = blockSheetData[rowIdx][tutorCodeCol];
      let className = blockSheetData[rowIdx][classCodeCol];
      let subjectName = className.slice(0,-2); // Subject name does not include the subject number at the end of the subject name, hence slice()
      let block = blockSheet.getSheetName();
      let sheetName;

      const ssTutor = SpreadsheetApp.openById(ssTutorId); // Opening Ops tutor data spreadsheet
      let ssTutorData = ssTutor.getSheets()[0].getDataRange().getValues();
      let noTutorsClasses = [];
      let teamTutorLogical = false; // Set as not having team tutors by default

      // Finding team tutors to notify of the absence. Only need to be notified of non- Find Cover absences since if an absence has Find Cover, the tutor has already been contacted about the absence and has said they want a team tutor. 
      [teamTutorCodes, blockSheetData] = findTeamTutorCodes(absentClassesNoFindCover, blockSheet, blockSheetData, rowIdx, className);

      let numTeamTutorsArray = Array.from(teamTutorCodes, (codes) => codes.length); // Maps each element of teamTutorCodes to the number of tutors who teach the class available for that class, e.g. [['JacDur', 'DioLep'], [], ['NatKhw']] => [2,0,1]
      
      if (numTeamTutorsArray.some((numTutors) => numTutors == 1)){ // Maps number of tutors to an array where every element is checked to see if the element is equal to 1. Returns a true value if 1 tutor is available to tutor at least 1 class (Notify TT check)

        // Notifying Team Tutors of the absences for classes that don't have ABS - Find Cover and updating blockSheetData
        blockSheetData = emailTTofAbsence(teamTutorCodes, absentClassesNoFindCover, blockSheetData, subjectName, block, ssTutorData, rowIdx);
      }

      // Creating an array of truthy values to do a for loop over two arrays depending on whether each array meets a condition
      let truthyArray = [false, false]; // By default, act on neither array
      if (numTeamTutorsArray.some((numTutors) => numTutors === 0)){
        truthyArray[0] = true;
      }
      if (absFindCoverClasses.length > 0){
        truthyArray[1] = true;
      }

      let absentClassesPlaceHolder; // Array to take the place of the absentClasses parameter depending on which absent classes are being actioned
      let numTeamTutorsArrayPlaceHolder; // Array to take place of numTeamTutors parameter " "
      for(let truthyIdx = 0; truthyIdx < 2; truthyIdx += 1){ // Triggers if there is at least 1 class absence where no tutors are available or there are ABS - Find Cover classes listed in the manual submission

        if (truthyArray[truthyIdx] === true){

          if (truthyIdx === 0){
            absentClassesPlaceHolder = absentClassesNoFindCover;
            numTeamTutorsArrayPlaceHolder = numTeamTutorsArray;
          }
          else if (truthyIdx === 1){
            absentClassesPlaceHolder = absFindCoverClasses;
            numTeamTutorsArrayPlaceHolder = absFindCoverClasses; 
            teamTutorLogical = true;
          }

          let noTutorsHtml;

          // Finding a list of tutors who can cover the class(es), calling absentClassesNoFindCover as these are the absences being considered
          [potentialCovers, potentialCoversCodes, noTutorsHtml, noTutorsClasses, emptyIndices, blockSheetData] = findPotentialCovers(numTeamTutorsArrayPlaceHolder,noTutorsClasses,absentClassesPlaceHolder,blockSheetData,block,subjectName,rowIdx,ssTutorData);

          // Creating a form link for the tutors to respond to
          let [formLink, sheetName] = createFormForClassCover(className, block, noTutorsClasses, potentialCoversCodes, tutorCode, teamTutorLogical); // Updates Daily Status and creates form link regardless of whether potential covers are found

          if (potentialCovers.length > 0){

            // Email all tutors in first batch from Ops Data (an ABS !! has occured)
            emailPotentialCovers(potentialCovers, className, noTutorsHtml, formLink, teamTutor = teamTutorLogical);

            // Setting class to Covers Contacted for each class where covers have been contacted
            for (let i = 0; i < emptyIndices.length; i += 1){
              let idx = emptyIndices[i];
              absClassCol = convertClassLetterToColumn(absentClassesPlaceHolder, idx); // Indices match that of the absent class array
              blockSheetData[rowIdx][absClassCol] = "Covers Contacted";
            }
          }
          
          else if (potentialCovers.length == 0){
            notifyOpsNoPotentialCoversFound(className, block);

            // Contacting Urgent Covers immediately if no potential covers are found in the Ops Data 
            const ssFormResponses = SpreadsheetApp.openById(formResponsesSheetId); // Class covers spreadsheet
            
            let classSheet = ssFormResponses.getSheetByName(sheetName);
            classSheet.getRange("I1").setValue("TRUE");
            let noTutorsClassesBlockWLetter = noTutorsClasses.map(letter => block + letter); // Converts ['A','C'] to ['Block 1A', 'Block 1C']
            contactUrgentCovers(classSheet, sheetName, noTutorsClassesBlockWLetter);

            // Setting class to Covers Contacted for each class where covers have been contacted
            for (let i = 0; i < emptyIndices.length; i += 1){
              let idx = emptyIndices[i];
              absClassCol = convertClassLetterToColumn(absentClassesPlaceHolder, idx); // Indices match that of the absent class array
              blockSheetData[rowIdx][absClassCol] = "ABS !!";
            }
          }
        }
      }
      
      // Updating sheet after all searches have been performed
      blockSheet.getDataRange().setValues(blockSheetData);
      SpreadsheetApp.flush(); // Updating sheet before rechecking it below

    }

    // Resetting all bolded classes to unbolded. Regardless of ignore or find and contact inputted, the row needs to be reset
    for (let classLetter of absentClasses){
      let classLetterColumn = convertClassLetterToColumn([classLetter],0, toNumber = false); // Gets letter of sheet corresponding to the class letter
      blockSheet.getRange(classLetterColumn + (rowIdx+1)).setFontWeight('normal');
    }

    // Resetting colouring of opsResponseCell if a form hasn't just been submitted
    if (opsResponseCell.getValue() !== "Updating sheet..."){
      opsResponseCell
      .clearDataValidations() // Removing data validation of opsResponseCell
      .clear(); // Clears range of contents and formats (including background colour)
    }
  }
}




function killSwitch() {
  // Function disbales all automated system components, only leaving the onOpen() trigger which produces a custom menu to enable/disbale the code. The kill switch submits a form into the Tutor Absences form with only the text "CODE DISABLED" in the first column, causing the row to go red with conditional formatting. Another sheet has a range imported starting from the next row after the CODE DISABLED row, using =MATCH("CODE DISABLED") which finds the largest index where a match occurs within the first column. The largest index is important since if the code is enabled then disabled again, the range that is imported is only to be from the most recent instance of disabling.
  

  let ui = SpreadsheetApp.getUi();
  let correctAnswer = "o0Psh3lpdEsk";

  const ssFormResponsesTutorAbsences = SpreadsheetApp.openById(formResponsesTutorAbsencesId);

  // Checking that the trigger exists and is currently active so as to not produce an error in removing a trigger that can't be found
  let triggers = ScriptApp.getProjectTriggers();
  if (triggers.length === 0){ 
    ui.alert('You do not have authorisation to disable this system. Please contact a member of the Operations team so that they can disable the system.');
  }
  else if (triggers.length === 1){ // If there's only 1 trigger, it's the onOpen() trigger. This is a failsafe
    ui.alert('Automated Emails are already disabled.');
  }
  else if (triggers.length > 1){ // If there is more than 1 trigger, the script is active
    let passwordAttempt = ui.prompt('Input Operations Gmail Password Below').getResponseText();
    
    if (passwordAttempt !== correctAnswer){
      ui.alert('Password Incorrect.');
    }
    else if (passwordAttempt === correctAnswer){
      // Are you sure? section
      let response = ui.alert('Password Correct. Are you sure you want to disable ALL automated tutor absences systems?', ui.ButtonSet.YES_NO);

      // If OK is selected, delete all triggers except the onOpen() trigger
      if (response === ui.Button.YES){

        // Finding the indices of the triggers to remove
        let triggerNames = triggers.map(trigger => trigger.getHandlerFunction()); // Maps every trigger to the name (a string) of the function it calls
        let lastStandingTriggerIndex = triggerNames.indexOf("onOpenMenu"); // Index of the onOpenMenu() function, the only trigger to not remove

        // Removing all other triggers except onOpen()
        for (let i = 0; i < triggers.length; i++){
          if (i === lastStandingTriggerIndex){
            continue;
          }
          else if (i !== lastStandingTriggerIndex){
            ScriptApp.deleteTrigger(triggers[i]);
          }
        }

        // Submitting a form with "CODE DISABLED" as the tutor code to indicate a break point for the 'Manual Absences Tracker' sheet in the Tutor Absences (Responses) spreadsheet

        // Submitting form for absence with pre-filled details
        let tutorAbsencesForm = FormApp.openById(tutorAbsencesFormId);

        let formResponse = tutorAbsencesForm.createResponse(); // tutorAbsencesForm is a global variable
        let formItemsArray = tutorAbsencesForm.getItems(); // Returns an array of all form items
        let response = "";

        // Prefilling form questions one at a time
        for (let i = 0; i < formItemsArray.length; i++){

          let item = formItemsArray[i];

          // Getting the item type to use createResponse on the specific class
          switch (i){
            case 0:
              item = item.asTextItem();
              response = item.createResponse("CODE DISABLED");
              formResponse.withItemResponse(response);
              break; // Switch runs each case after (and including) the first match until a break is found
            case 1:
              item = item.asListItem();
              response = item.createResponse("Other"); // Placeholder, question requires a response
              formResponse.withItemResponse(response);
              break;
            case 2:
              break; // Skipping the class name corresponding with other
            case 3:
              item = item.asMultipleChoiceItem();
              response = item.createResponse("Block 1"); // Placeholder, question requires a response
              formResponse.withItemResponse(response);
              break;
            case 4:
              item = item.asCheckboxItem();
              response = item.createResponse(["A"]); // Placeholder, question requires a response
              formResponse.withItemResponse(response);
              break;
          }
        }

        // Submitting the form response
        formResponse.submit();

        // Confirming the system has been disabled to the user
        ui.alert("Automed Emails Disabled.");

        // Emailing Ops to confirm that the system has been disabled
        let address = opsEmail; 
        let subject = "Automated Tutor Absences have been DISABLED"; 
        let msgHtml = 
        "<p> Hi Ops, </p>" +

        "<p>This email is to inform you that the <b>Automated Tutor Absences System </b> has been <b>DISABLED</b>.</p>" + 

        "<p> This means that all future tutor absences will <b>NOT</b> automatically be inputted and actioned and that Ops will <b>no longer get updates</b> about classes yet to be covered/absences requiring manual input. Until the system has been switched back on, tutor absences are to be inputted manually by <b>BCCing potential tutors</b> in an email containing the <b>time, block and class</b> being covered. See sent emails or the Roles sheet for a template.</p>" + 

        "<p>The Daily Status section of the code is also <b>not functional</b>. Do <b>NOT</b> try to find/track tutor absences using this system as this code will not run either. Please continue to track the Tutor Sign In sheet manually, however no code will run based on your actions.</p>" +

        "<p>This is an automated email, do not reply. <b>PLEASE NOTIFY THE OPS TEAM IF YOU ARE READING THIS EMAIL</b>. If you have any questions please consult your Ops Coords. </p>" +

        "<p>Kind Regards, </p>"
        ; // Formatted in HTML to allow for bold text, <p> opens new paragraph, </p> closes paragraph

        let msgPlain = msgHtml.replace(/(<([^>]+)>)/ig, ""); // replaces special characters in HTML with "" (nothing) in the body of the text
        MailApp.sendEmail(address, subject, msgPlain, {htmlBody: msgHtml}); // htmlBody formats body as an html text
      }
      else if (response === ui.Button.NO){ // Exiting function call if they do not wish to continue
        return;
      }
    }
  } 

}


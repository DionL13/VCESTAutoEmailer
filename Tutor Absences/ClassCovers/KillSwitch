function onOpenMenu(){
// Function creates a custom menu when the sheet is opened and displays it. This menu is to give the option to run the killSwitch code

  // Checking that the trigger exists and is currently active so as to not produce an error in removing a trigger that can't be found
  let spreadSheet = SpreadsheetApp.getActiveSpreadsheet();
  let triggers = ScriptApp.getProjectTriggers(); // Since this only gets USER triggers, and the script is owned by the Operations gmail account, no one other than those operating under the Ops email will be able to use this feature. Returns an array of triggers

  triggers.forEach((trigger) => console.log(trigger.getHandlerFunction()));

  // Creating the custom menu depending on whether the script is enabled or not
  let ui = SpreadsheetApp.getUi();
  let menu = ui.createMenu('Manage System');

  // Adding custom menu options
  if (triggers.length > 1){ // If there is only 1 trigger, it's the onOpen() trigger to create the custom menu
    menu.addItem('Disable ALL Automated Tutor Absences Systems', 'killSwitch'); // Creates a menu item called Disable Automated Emails, which runs the killSwitch function when clicked
  }
  else if (triggers.length === 1){
    menu.addItem('Enable ALL Automated Tutor Absences Systems', 'reviveSwitch'); // Re-enables automated emails, running a function called reviveSwitch
  }

  menu.addToUi();
}




 function updateTutorSignIn(e) {
  // Function triggers on a tutor absence form submission to takes tutor code and subject and searches the tutor sign in sheet for matches in both columns. Once this occurs, inputs absences in the associated columns. 
  
  const ssFormResponses = SpreadsheetApp.openById(formResponsesSheetId); // Class covers spreadsheet
  const ssFormResponsesTutorAbsences = SpreadsheetApp.openById(formResponsesTutorAbsencesId);

  let tutorAbsencesData = ssFormResponsesTutorAbsences.getDataRange().getValues(); // Accessing data once, excluding questions row

  let tutorCodeColForm = colLettertoColNumber("B"); // Column where tutor codes are found in the form responses sheet
  let subjectNameCol = colLettertoColNumber("C");
  let otherCol = colLettertoColNumber("D");
  let blockCol = colLettertoColNumber("E");
  let classCol = colLettertoColNumber("F");

  // Key information for an absence
  let tutorCode; 
  let subjectName = ""; // To be updated in the next if statement
  let className = ""; // class name is the full subject name including the class number (e.g Physics 3 & 4 1)
  let teamTutorCodes = "";

  // Sign-In sheet columns (for changes if necessary)
  let tutorCodeColSignIn = colLettertoColNumber("C"); // Column where tutor codes are found in the tutor sign-in sheets
  let classNameCol = colLettertoColNumber("A"); // Column where class name is found in the tutor sign-in sheets
  let absClassCol = ""; // Column to be updated which converts class letters to their associated columns in the tutor sign-in sheets
  let opsResponseCol = "L"

  const ssSignIn = SpreadsheetApp.openById(signInSSId);
  const ssTutor = SpreadsheetApp.openById(ssTutorId); // Opening Ops tutor data spreadsheet

  // Tutor Data Columns
  let ssTutorData = ssTutor.getSheets()[0].getDataRange().getValues();

  // Sheet-specific variables
  let block;
  let blockSheet;
  let blockSheetData;
  let noTutorsClasses = []; // Array to store which classes have no tutor
  
  // Edited cells (either due to form submission or direct edits)
  let edited = e.range; // gets range of edited cells from form submission
  let row = edited.getRow() - 1; // -1 to match row index of data array

  // Getting subject name for when Other is not selected (i.e. Other column is blank)
  if (tutorAbsencesData[row][subjectNameCol] !==  "" && tutorAbsencesData[row][subjectNameCol] !== "Other"){
    subjectName = tutorAbsencesData[row][subjectNameCol];
  } 
  else if (tutorAbsencesData[row][otherCol] !== ""){ // If Other is selected, a different class will be typed out manually
    notifyOpsOrange();
  }

  // CODE ENABLED/DISABLED form submissions have subject as "Other" with no subject actually listed
  if (tutorAbsencesData[row][subjectNameCol] === "Other" && tutorAbsencesData[row][otherCol] === ""){
    return;
  }
  
  if (subjectName !== ""){
    let absentClassesString;
    let absentClasses;
    absentClassesString = tutorAbsencesData[row][classCol]; // String of class absences, e.g "A, C" has length 4. 
    absentClasses = absentClassesString.split(", "); // Splits above string into vector where new elements occur after a comma and , e.g "A, C" becomes ["A","C"]

    // Searching tutor sign-in sheet for tutor code
    let block = tutorAbsencesData[row][blockCol];
    blockSheet = ssSignIn.getSheetByName(block); // Gets Block X sheet to be altered
    let numRows = blockSheet.getLastRow(); // Gets last non-empty row of sign-sheet for the given block
    blockSheetData = blockSheet.getDataRange().getValues(); 

    tutorCode = tutorAbsencesData[row][tutorCodeColForm];

    for (let rowIdx = 6; rowIdx < numRows; rowIdx += 1){ // Starts at 6 since this is the row where classes begin (accounting for array indexing). Note includes class covers section since class covers may no longer be able to cover a class. 

      if (blockSheetData[rowIdx][tutorCodeColSignIn] == tutorCode && blockSheetData[rowIdx][classNameCol].slice(0,-2) == subjectName){ // Class for tutor code is found in block and subject name matches class name (without " x" where x is the class number). Can only occur once as tutors can only teach one class per block

        // Searching for a team tutor, if any are found that are available to tutor, store their code for each unavailability in teamTutorCodes
        className = blockSheetData[rowIdx][classNameCol]; 

        // Finding team tutor codes for the class and updating blockSheetData values
        [teamTutorCodes, blockSheetData] = findTeamTutorCodes(absentClasses, blockSheet, blockSheetData, rowIdx, className);

        let numTeamTutorsArray = Array.from(teamTutorCodes, (codes) => codes.length); // Maps each element of teamTutorCodes to the number of tutors available for that class 

        if (numTeamTutorsArray.some((numTutors) => numTutors == 1)){ // Maps number of tutors to an array where every element is checked to see if the element is equal to 1. Returns a true value if at least 1 tutor is available to tutor every class (Notify TT check)

          // Notifying team tutors and updating blockSheetData
          blockSheetData = emailTTofAbsence(teamTutorCodes, absentClasses, blockSheetData,subjectName, block, ssTutorData, rowIdx);

        }
        if (numTeamTutorsArray.some((numTutors) => numTutors == 0)){ // Triggers if there is at least 1 class absence where no tutors are available
          
          let noTutorsHtml; 

          // Finding a list of tutors who can cover the class(es)
          [potentialCovers, potentialCoversCodes, noTutorsHtml, noTutorsClasses, emptyIndices, blockSheetData] = findPotentialCovers(numTeamTutorsArray,noTutorsClasses,absentClasses,blockSheetData,block,subjectName,rowIdx,ssTutorData);

          // Creating a form link for the tutors to respond to
          let [formLink, sheetName] = createFormForClassCover(className, block, noTutorsClasses, potentialCoversCodes, tutorCode); // Updates Daily Status and creates form link regardless of whether potential covers are found
          
          if (potentialCovers.length > 0){

            // Email all tutors in first batch from Ops Data (an ABS !! has occured)
            emailPotentialCovers(potentialCovers, className, noTutorsHtml, formLink);

            // Setting class to Covers Contacted for each class where covers have been contacted
            for (let i = 0; i < emptyIndices.length; i += 1){
              let idx = emptyIndices[i];
              absClassCol = convertClassLetterToColumn(absentClasses, idx); // Indices match that of the absent class array
              blockSheetData[rowIdx][absClassCol] = "Covers Contacted";
            }
          }
          else if (potentialCovers.length == 0){
            notifyOpsNoPotentialCoversFound(className, block);

            // Contacting Urgent Covers immediately if no potential covers are found in the Ops Data 
            let classSheet = ssFormResponses.getSheetByName(sheetName);
            classSheet.getRange("I1").setValue("TRUE");
            let noTutorsClassesBlockWLetter = noTutorsClasses.map(letter => block + letter); // Converts ['A','C'] to ['Block 1A', 'Block 1C']
            contactUrgentCovers(classSheet, sheetName, noTutorsClassesBlockWLetter);

            // Setting class to Covers Contacted for each class where covers have been contacted
            for (let i = 0; i < emptyIndices.length; i += 1){
              let idx = emptyIndices[i];
              absClassCol = convertClassLetterToColumn(absentClasses, idx); // Indices match that of the absent class array
              blockSheetData[rowIdx][absClassCol] = "ABS !!";
            }
          }
        }

        blockSheetData[rowIdx][colLettertoColNumber(opsResponseCol)] = ""; // Clearing "Updating sheet..."
        blockSheet.getRange(opsResponseCol + (rowIdx+1)).clear();

        break; // Exits for loop once tutor is found
      } 
    }
    if (teamTutorCodes === ""){  // "===" is a strict equality, so accounts for differences across data types
     // If the team tutor codes haven't been updated to a nested array, the absent tutor was found in the sign-in sheet
      notifyOpsCodeNotFound(tutorCode, subjectName, block, absentClassesString);
    }
  } 

  console.log("no problems here yet");
  console.log("blockSheet: ", blockSheet);
  console.log("blockSheetData: ", blockSheetData);

  // Updating sheet after all searches have been performed
  blockSheet.getDataRange().setValues(blockSheetData);

}

